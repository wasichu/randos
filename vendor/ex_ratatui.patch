+// randos: clear the physical terminal and reset Ratatui's remembered cells
+// together, so the next draw restores unchanged UI after multilingual overlays.
+#[rustler::nif(schedule = "DirtyIo")]
+fn clear_terminal(resource: ResourceArc<TerminalResource>) -> Result<Atom, Error> {
+    let mut guard = resource
+        .terminal
+        .lock()
+        .map_err(|_| Error::Term(Box::new("terminal lock poisoned")))?;
+    let terminal = guard
+        .as_mut()
+        .ok_or_else(|| Error::Term(Box::new("terminal not initialized")))?;
+    match terminal {
+        AnyTerminal::Crossterm(t) => t.clear(),
+        AnyTerminal::Test(t) => t.clear().map_err(std::io::Error::other),
+    }
+    .map_err(|e| Error::Term(Box::new(format!("{e}"))))?;
+    Ok(atoms::ok())
+}

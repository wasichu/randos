#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "الحالة"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "The relay is partly working"
msgstr "المرحّل يعمل جزئيا"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "The relay is working"
msgstr "المرحّل يعمل"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "The relay isn't working"
msgstr "المرحّل لا يعمل"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Today"
msgstr "اليوم"

#. A figure on the status page: the typical length of a call today.
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Typical length"
msgstr "المدة المعتادة"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Whether calls can connect right now, and how today is going."
msgstr "هل يمكن إجراء المكالمات الآن، وكيف تسير الأمور اليوم."

#. A relay server's state on the status page: it is working (up).
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "working"
msgstr "يعمل"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counted across %{answered} of %{total} servers."
msgstr "تمّ احتساب النتيجة بناءً على استجابات %{answered} من أصل %{total} خادمًا."

#. A call's typical length: less than one minute (min = minutes).
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "under 1 min"
msgstr "أقل من دقيقة"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counting since %{time} UTC on %{date}. This server starts fresh whenever it sleeps or is updated, so these are today's calls since then."
msgstr "تم تسجيل عدد المكالمات منذ الساعة %{time} بتوقيت جرينتش في تاريخ %{date}. يبدأ هذا الخادم من جديد في كل مرة يتم إيقافه أو تحديثه، لذا فإن هذه هي المكالمات المسجلة اليوم منذ ذلك الحين."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counting since %{time} UTC on %{date}: today's calls so far."
msgstr "عدد المكالمات المسجلة منذ الساعة %{time} بتوقيت جرينتش في تاريخ %{date}: عدد المكالمات حتى الآن لهذا اليوم."

#. Footer link to the page on what randos sees, logs and keeps (privacy).
#: lib/randos_web/components/layouts.ex
#, elixir-autogen, elixir-format
msgid "Privacy"
msgstr "الخصوصية"

#: lib/randos_web/components/layouts.ex
#, elixir-autogen, elixir-format
msgid "Running this commit plus changes not yet committed"
msgstr "تنفيذ هذا الكوميت بالإضافة إلى التغييرات التي لم يتم تسجيلها بعد"

#. Footer link to the source code; AGPL-3.0 is its license (keep it as is).
#: lib/randos_web/components/layouts.ex
#, elixir-autogen, elixir-format
msgid "Source (AGPL-3.0)"
msgstr "المصدر (AGPL-3.0)"

#: lib/randos_web/components/layouts.ex
#, elixir-autogen, elixir-format
msgid "The commit this server runs"
msgstr "عملية الالتزام التي يقوم بها هذا الخادم"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "What each part of randos sees, logs, and keeps, with the configuration behind every claim:"
msgstr "ما يراه كل جزء من الـ randos وما يسجله ويحتفظ به، مع الإعدادات الخاصة بكل طلب:"

#. Link text, inside a sentence: the page on what randos sees, logs and keeps (privacy).
#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "privacy"
msgstr "الخصوصية"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Your rando's connection dropped; waiting a few seconds for them to come back."
msgstr "اتصالك rando انقطع؛ ينتظر بضع ثوانٍ حتى يعودوا."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "A language pair shows once it has at least %{min} calls; smaller ones are counted under “other”."
msgstr "يتم عرض كل زوج لغوي مرة واحدة بعد استيفاء شرط وجود ما لا يقل عن %{min} مكالمة. أما المكالمات الأقل من ذلك، فسيتم تصنيفها تحت فئة \"أخرى\"."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "How languages are counted"
msgstr "كيف يتم احتساب عدد اللغات؟"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "We count calls, not people: no addresses, no ids, nothing about anyone; only these totals are kept."
msgstr "نحن نحسب المكالمات وليس الأشخاص: لا عناوين، ولا أرقام هويات، ولا أي معلومات عن أي شخص؛ يتم الاحتفاظ فقط بهذه الإحصائيات الإجمالية."

#. Label of the search box that finds a piece of this site's text and its translation.
#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase"
msgstr "ابحث عن عبارة"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase, in English or %{language}"
msgstr "ابحث عن عبارة، باللغة الإنجليزية أو %{language}"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Not translated yet"
msgstr "غير مترجم حتى الآن"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Nothing matches."
msgstr "لا يوجد شيء يطابق."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Pick the language you'd like to check."
msgstr "اختر اللغة التي ترغب في التحقق منها."

#. Button: suggest a better translation of this text.
#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Suggest a fix"
msgstr "اقترح حلاً"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "The translations of this site were made by machine and haven't been reviewed by people yet. If something reads wrong in your language, please help fix it: find the text, write how it should read, and we'll do the rest."
msgstr "تمت ترجمة محتويات هذا الموقع آليًا ولم يتم مراجعتها من قبل متخصصين لغويين بعد. إذا لاحظت أي أخطاء أو عبارات غير دقيقة في لغتك، فيرجى مساعدتنا في تصحيحها: حدد النص المعني، واكتب الصيغة الصحيحة التي تراه مناسبة، وسنتولى نحن بقية العمل."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "This site's translations were made by machine. If something reads wrong, find it below and press “Suggest a fix”: it opens an issue on GitHub with everything filled in but your fix (you need a GitHub account). A pull request with your fix opens on its own, and it goes live once it's reviewed."
msgstr "تمت ترجمة محتوى هذا الموقع بواسطة نظام آلي. إذا لاحظت أي أخطاء، يمكنك العثور عليها أدناه والضغط على \"اقتراح تصحيح\": سيؤدي ذلك إلى فتح مسألة على منصة GitHub مع ملء جميع الحقول باستثناء التصحيح الذي تقترحه (ستحتاج إلى حساب على GitHub). سيتم فتح طلب تعديل تلقائيًا يتضمن التصحيح الذي اقترحته، وسيتم نشره بمجرد مراجعته."

#. Opens the list of languages you can hear, to change it.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Change"
msgstr "تغيير"

#. Closes the list of languages you can hear, once you've changed it.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Done"
msgstr "تم"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Pick at least one language to hear"
msgstr "اختر لغة واحدة على الأقل للاستماع إليها"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You'll hear %{languages}"
msgstr "ستسمعون بلغات: %{languages}"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Reconnecting audio…"
msgstr "إعادة توصيل الصوت…"

#. When the call's time is up, after you chose to keep talking: the other person hasn't chosen yet.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You agreed to continue, waiting on your rando…"
msgstr "لقد وافقت على الاستمرار، في انتظار rando…"

#. A call's typical length, at the longest a call can run; the "+" already says "or more", so don't add words for it (min = minutes).
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "%{minutes}+ min"
msgstr "%{minutes}+ دقيقة على الأقل"

#. A count on the status page: calls whose two people chose to keep talking beyond the first %{minutes} minutes ("past" as in "beyond", not "in the past").
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Continued past %{minutes} minutes"
msgstr "استمرار المكالمة بعد مرور %{minutes} دقيقة"

#. Why the relay check failed: the relay server closed the connection.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "connection closed"
msgstr "الوصلة مغلقة"

#. Why the relay check failed: no connection to the relay server.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "couldn't connect"
msgstr "لا أستطيع الاتصال"

#. Why the relay check failed: the relay server's name didn't resolve (DNS).
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "couldn't find the server"
msgstr "لا أستطيع العثور على الخادم"

#. Why the relay check failed: the relay server refused our credentials.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "credentials refused"
msgstr "وثائق التفويض المرفوضة"

#. Why the relay check failed: the relay server didn't answer.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "no answer"
msgstr "لا جواب"

#. Why the relay check failed: the relay server didn't ask for credentials.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "no credentials asked for"
msgstr "لا توجد شهادات مطلوبة"

#. Why the relay check failed: the relay server refused the request.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "refused"
msgstr "رفض"

#. Why the relay check failed: the secure (TLS) connection failed.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "secure connection failed"
msgstr "فشل الاتصال الآمن"

#. Why the relay check failed: the relay server's reply made no sense.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "unexpected reply"
msgstr "رد غير متوقع"

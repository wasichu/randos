msgid "Counting since %{time} UTC on %{date}. This server starts fresh whenever it sleeps or is updated, so these are today's calls since then."
msgstr "Perhitungan dimulai sejak pukul %{time} UTC pada tanggal %{date}. Server ini selalu memulai ulang setiap kali dimatikan atau diperbarui, jadi ini adalah jumlah panggilan yang tercatat hari ini sejak saat itu."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counting since %{time} UTC on %{date}: today's calls so far."
msgstr "Perhitungan sejak pukul %{time} UTC pada tanggal %{date}: jumlah panggilan yang telah masuk hingga saat ini."


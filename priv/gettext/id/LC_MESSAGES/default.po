#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Your rando's connection dropped; waiting a few seconds for them to come back."
msgstr "Koneksi rando Anda terputus; tunggu beberapa detik hingga mereka kembali terhubung."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "A language pair shows once it has at least %{min} calls; smaller ones are counted under “other”."
msgstr "Sebuah pasangan bahasa akan ditampilkan jika memiliki setidaknya %{min} panggilan; yang jumlahnya lebih sedikit akan dihitung dalam kategori “lainnya”."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "How languages are counted"
msgstr "Bagaimana bahasa-bahasa dihitung"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "We count calls, not people: no addresses, no ids, nothing about anyone; only these totals are kept."
msgstr "Kami menghitung jumlah panggilan, bukan orangnya: tanpa alamat, tanpa ID, tanpa informasi apa pun tentang siapa pun; hanya total angka-angka inilah yang disimpan."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase"
msgstr "Temukan sebuah frasa"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase, in English or %{language}"
msgstr "Temukan sebuah frasa, dalam bahasa Inggris atau %{language}"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Not translated yet"
msgstr "Belum diterjemahkan"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Nothing matches."
msgstr "Tidak ada yang cocok."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Pick the language you'd like to check."
msgstr "Pilih bahasa yang ingin Anda periksa."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Suggest a fix"
msgstr "Usulkan perbaikan"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "The translations of this site were made by machine and haven't been reviewed by people yet. If something reads wrong in your language, please help fix it: find the text, write how it should read, and we'll do the rest."
msgstr "Terjemahan situs ini dibuat oleh mesin dan belum ditinjau oleh manusia. Jika ada bagian yang salah dalam bahasa Anda, tolong bantu perbaikinya: temukan teksnya, tuliskan bagaimana seharusnya tertulis, dan kami akan menangani sisanya."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "This site's translations were made by machine. If something reads wrong, find it below and press “Suggest a fix”: it opens an issue on GitHub with everything filled in but your fix (you need a GitHub account). A pull request with your fix opens on its own, and it goes live once it's reviewed."
msgstr "Terjemahan di situs ini dibuat oleh mesin. Jika ada bagian yang salah, cari di bawahnya lalu tekan “Suggest a fix”: hal tersebut akan membuka masalah di GitHub dengan semua informasi sudah terisi, kecuali solusi yang Anda berikan (Anda memerlukan akun GitHub). Pull request dengan solusi Anda akan dibuat secara otomatis, dan akan diaktifkan setelah ditinjau."

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Change"
msgstr "Ganti"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Done"
msgstr "Selesai"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Pick at least one language to hear"
msgstr "Pilih setidaknya satu bahasa untuk didengar"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You'll hear %{languages}"
msgstr "Anda akan mendengar %{languages}"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Reconnecting audio…"
msgstr "Menghubungkan kembali audio…"

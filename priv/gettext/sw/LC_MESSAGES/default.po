#. A call's typical length: less than one minute (min = minutes).
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "under 1 min"
msgstr "chini ya dakika 1"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counting since %{time} UTC on %{date}. This server starts fresh whenever it sleeps or is updated, so these are today's calls since then."
msgstr "Kuhesabu kuanzia saa %{time} za UTC tarehe %{date}. Huduma hii huanzishwa upya kila inapoingia katika hali ya “usingizi” (sleep mode) au inapofanyiwa marekebisho, kwa hivyo, haya ni matokeo ya leo tangu wakati huo."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Counting since %{time} UTC on %{date}: today's calls so far."
msgstr "Kuanzia saa ya %{time} UTC siku ya %{date}: idadi ya simu zilizopigwa hadi sasa leo."


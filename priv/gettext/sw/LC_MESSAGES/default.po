msgstr "Mchakato wa mtandao huu hufanya kazi"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "What each part of randos sees, logs, and keeps, with the configuration behind every claim:"
msgstr "Kila sehemu ya programu ya \"randos\" inaona, husajili, na kuhifadhi data, pamoja na maelezo ya usanidi ambayo huambatana na kila ombi."

#. Link text, inside a sentence: the page on what randos sees, logs and keeps (privacy).
#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "privacy"
msgstr "faragha"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Your rando's connection dropped; waiting a few seconds for them to come back."
msgstr "rando yako ya uhusiano kuanguka; kusubiri sekunde chache kwa ajili yao kuja nyuma."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "A language pair shows once it has at least %{min} calls; smaller ones are counted under “other”."
msgstr "Jozi ya lugha huonekana mara baada ya kuwa na angalau %{min} matumizi; yale yaliyopungua hayo huhesabiwa chini ya “vingine”."

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "How languages are counted"
msgstr "Jinsi lugha zinahesabiwa"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "We count calls, not people: no addresses, no ids, nothing about anyone; only these totals are kept."
msgstr "Sisi tunahesabu idadi ya simu zilizopigwa, si watu; hatutunzi taarifa za anwani, vitambulisho, au taarifa yoyote kuhusu mtu yeyote; tunahifadhi tu takwimu hizo za jumla."

#. Label of the search box that finds a piece of this site's text and its translation.
#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase"
msgstr "kutafuta maneno"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase, in English or %{language}"
msgstr "Kupata kauli, kwa Kiingereza au %{language}"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Not translated yet"
msgstr "Hakuna kutafsiriwa"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Nothing matches."
msgstr "Hakuna kitu kinacholingana."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Pick the language you'd like to check."
msgstr "Chagua lugha unayotaka kuangalia."

#. Button: suggest a better translation of this text.
#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Suggest a fix"
msgstr "Kupendekeza marekebisho"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "The translations of this site were made by machine and haven't been reviewed by people yet. If something reads wrong in your language, please help fix it: find the text, write how it should read, and we'll do the rest."
msgstr "Tafsiri za tovuti hii zimetengenezwa kwa kutumia programu, na bado hazijapitia ukaguzi wa watu. Ikiwa kuna kitu ambacho hakisomeki vizuri katika lugha yako, tafadhali saidia kurekebisha: tafuta maandishi, andika jinsi kinapaswa kusomwa, na sisi tutashughulikia mambo mengine."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "This site's translations were made by machine. If something reads wrong, find it below and press “Suggest a fix”: it opens an issue on GitHub with everything filled in but your fix (you need a GitHub account). A pull request with your fix opens on its own, and it goes live once it's reviewed."
msgstr "Tafsiri za tovuti hii zimetengenezwa kwa kutumia programu. Ikiwa kuna kitu ambacho hakielezeki vizuri, tafuta sehemu hiyo hapa chini na ubofye \"Pendekeza marekebisho\": hii itafungua ombi kwenye GitHub ambapo kila kitu kimeandikwa isipokuwa marekebisho yako (unahitaji akaunti ya GitHub). Ombi la marekebisho litafunguliwa kiotomatiki, na litatumika baada ya kukaguliwa."

#. Opens the list of languages you can hear, to change it.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Change"
msgstr "Badilisha"

#. Closes the list of languages you can hear, once you've changed it.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Done"
msgstr "Imekwisha"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Pick at least one language to hear"
msgstr "Chagua lugha moja au zaidi ili kusikiliza"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You'll hear %{languages}"
msgstr "Utasikia lugha za: %{languages}"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Reconnecting audio…"
msgstr "Kuunganisha tena sauti…"

#. When the call's time is up, after you chose to keep talking: the other person hasn't chosen yet.
#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You agreed to continue, waiting on your rando…"
msgstr "Wewe walikubaliana kuendelea, kusubiri juu yako rando…"

#. A call's typical length, at the longest a call can run; the "+" already says "or more", so don't add words for it (min = minutes).
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "%{minutes}+ min"
msgstr "%{minutes}+ dakika"

#. A count on the status page: calls whose two people chose to keep talking beyond the first %{minutes} minutes ("past" as in "beyond", not "in the past").
#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "Continued past %{minutes} minutes"
msgstr "Kuendelea nyuma %{minutes} dakika"

#. Why the relay check failed: the relay server closed the connection.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "connection closed"
msgstr "uhusiano imefungwa"

#. Why the relay check failed: no connection to the relay server.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "couldn't connect"
msgstr "haikuweza kuungana"

#. Why the relay check failed: the relay server's name didn't resolve (DNS).
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "couldn't find the server"
msgstr "haikuweza kupata server"

#. Why the relay check failed: the relay server refused our credentials.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "credentials refused"
msgstr "vitambulisho kukataa"

#. Why the relay check failed: the relay server didn't answer.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "no answer"
msgstr "hakuna majibu"

#. Why the relay check failed: the relay server didn't ask for credentials.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "no credentials asked for"
msgstr "hakuna taarifa za uthibitisho zilitolewa"

#. Why the relay check failed: the relay server refused the request.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "refused"
msgstr "kukataliwa"

#. Why the relay check failed: the secure (TLS) connection failed.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "secure connection failed"
msgstr "uhusiano salama kushindwa"

#. Why the relay check failed: the relay server's reply made no sense.
#: lib/randos_web/relay_reasons.ex
#, elixir-autogen, elixir-format
msgid "unexpected reply"
msgstr "jibu isiyotarajiwa"

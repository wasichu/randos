#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "The interface is quiet on purpose. The goal is low-pressure human presence, not performance or engagement loops."
msgstr "Giao diện được thiết kế đơn giản, không cầu kỳ. Mục tiêu là tạo ra một môi trường thân thiện, giảm áp lực cho người dùng, thay vì tập trung vào hiệu suất hay các tương tác liên tục."

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "There are no accounts, profiles, contacts, followers, feeds, streaks, scores, or permanent social graph. randos is closer to conversational infrastructure than social media."
msgstr "Không có tài khoản, hồ sơ người dùng, danh bạ, người theo dõi, nguồn cấp dữ liệu, chuỗi thành tích, điểm số hay mạng lưới quan hệ xã hội cố định. randos gần giống với một nền tảng hỗ trợ giao tiếp hơn là một mạng xã hội."


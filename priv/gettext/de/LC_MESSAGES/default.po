msgid "How languages are counted"
msgstr "Wie Sprachen gezählt werden"

#: lib/randos_web/live/status_live.ex
#, elixir-autogen, elixir-format
msgid "We count calls, not people: no addresses, no ids, nothing about anyone; only these totals are kept."
msgstr "Wir zählen Anrufe, nicht Menschen: keine Adressen, keine Ausweise, nichts über jemanden; nur diese Summen werden gehalten."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase"
msgstr "Einen Satz finden"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Find a phrase, in English or %{language}"
msgstr "Suchen Sie einen Satz, in Englisch oder %{language}"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Not translated yet"
msgstr "Noch nicht übersetzt"

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Nothing matches."
msgstr "Nichts passt."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Pick the language you'd like to check."
msgstr "Wählen Sie die Sprache aus, die Sie überprüfen möchten."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "Suggest a fix"
msgstr "Einen Fix vorschlagen"

#: lib/randos_web/live/about_live.ex
#, elixir-autogen, elixir-format
msgid "The translations of this site were made by machine and haven't been reviewed by people yet. If something reads wrong in your language, please help fix it: find the text, write how it should read, and we'll do the rest."
msgstr "Die Übersetzungen dieser Website wurden von der Maschine erstellt und wurden noch nicht von den Leuten überprüft. Wenn etwas in Ihrer Sprache falsch liest, helfen Sie bitte, es zu beheben: finden Sie den Text, schreiben Sie, wie er gelesen werden soll, und wir tun den Rest."

#: lib/randos_web/live/translations_live.ex
#, elixir-autogen, elixir-format
msgid "This site's translations were made by machine. If something reads wrong, find it below and press “Suggest a fix”: it opens an issue on GitHub with everything filled in but your fix (you need a GitHub account). A pull request with your fix opens on its own, and it goes live once it's reviewed."
msgstr "Wenn etwas falsch liest, finden Sie es unten und drücken Sie eine Lösung vorschlagen: es öffnet ein Problem auf GitHub mit allem, was ausgefüllt ist, aber Ihre Lösung (Sie brauchen ein GitHub-Konto). Eine Pull-Anfrage mit Ihrer Lösung öffnet sich auf eigene Faust, und es geht live, wenn es überprüft wird."

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Change"
msgstr "Veränd."

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Done"
msgstr "Fertig"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Pick at least one language to hear"
msgstr "Wählen Sie mindestens eine Sprache, um zu hören"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "You'll hear %{languages}"
msgstr "Du wirst es hören %{languages}"

#: lib/randos_web/components/home_components.ex
#, elixir-autogen, elixir-format
msgid "Reconnecting audio…"
msgstr "Audio wieder verbinden..."

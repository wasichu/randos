#cloud-config
package_update: true

write_files:
  - path: /etc/randos-coturn.env
    owner: root:root
    permissions: "0600"
    content: |
      PROJECT_NAME=${project_name}
      TURN_HOSTNAME=${turn_hostname}
      TURN_REALM=${turn_realm}
      TURN_SHARED_SECRET=${turn_shared_secret}
      RELAY_MIN_PORT=${relay_min_port}
      RELAY_MAX_PORT=${relay_max_port}
      LETSENCRYPT_EMAIL=${letsencrypt_email}
      COTURN_IMAGE=${coturn_image}
      TURN_CREDENTIAL_TTL_SECONDS=${turn_credential_ttl_secs}

  - path: /usr/local/sbin/randos-coturn-bootstrap
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      LOG_FILE="/var/log/randos-coturn-bootstrap.log"
      exec > >(tee -a "$LOG_FILE") 2>&1

      echo "[$(date --iso-8601=seconds)] Starting Randos coturn bootstrap"

      source /etc/randos-coturn.env

      export DEBIAN_FRONTEND=noninteractive

      apt-get update
      apt-get install -y \
        ca-certificates \
        certbot \
        curl \
        dnsutils \
        docker.io \
        netcat-openbsd \
        ufw

      systemctl enable --now docker

      mkdir -p /etc/coturn
      mkdir -p /etc/coturn/certs
      chmod 755 /etc/coturn
      chmod 755 /etc/coturn/certs

      CERT_DIR="/etc/letsencrypt/live/$TURN_HOSTNAME"
      FULLCHAIN="$CERT_DIR/fullchain.pem"
      PRIVKEY="$CERT_DIR/privkey.pem"
      COTURN_FULLCHAIN="/etc/coturn/certs/fullchain.pem"
      COTURN_PRIVKEY="/etc/coturn/certs/privkey.pem"

      if [ -f "$FULLCHAIN" ] && [ -f "$PRIVKEY" ]; then
        echo "[$(date --iso-8601=seconds)] Existing Let's Encrypt certificate found for $TURN_HOSTNAME"
      else
        echo "[$(date --iso-8601=seconds)] Attempting Let's Encrypt certificate issuance for $TURN_HOSTNAME"

        if [ -n "$LETSENCRYPT_EMAIL" ]; then
          CERTBOT_EMAIL_ARGS=(--email "$LETSENCRYPT_EMAIL")
        else
          CERTBOT_EMAIL_ARGS=(--register-unsafely-without-email)
        fi

        if certbot certonly \
          --standalone \
          --non-interactive \
          --agree-tos \
          "$${CERTBOT_EMAIL_ARGS[@]}" \
          -d "$TURN_HOSTNAME"; then
          echo "[$(date --iso-8601=seconds)] Certificate issued for $TURN_HOSTNAME"
        else
          echo "[$(date --iso-8601=seconds)] Certificate issuance failed. This is expected if DNS is not ready yet."
          echo "[$(date --iso-8601=seconds)] After DNS resolves, rerun: sudo /usr/local/sbin/randos-coturn-bootstrap"
        fi
      fi

      # Advertise the reserved IP for relays. DigitalOcean delivers reserved-IP
      # traffic to the droplet's anchor IP, so map public -> anchor.
      METADATA="http://169.254.169.254/metadata/v1"
      RESERVED_IP="$(curl -fsS "$METADATA/reserved_ip/ipv4/ip_address" 2>/dev/null || true)"
      ANCHOR_IP="$(curl -fsS "$METADATA/interfaces/public/0/anchor_ipv4/address" 2>/dev/null || true)"
      EXTERNAL_IP_LINE=""
      if [ -n "$RESERVED_IP" ] && [ -n "$ANCHOR_IP" ]; then
        EXTERNAL_IP_LINE="external-ip=$RESERVED_IP/$ANCHOR_IP"
      fi

      # TLS (turns: on 5349) only once a certificate exists. Without one, coturn
      # still serves STUN/TURN on 3478 and the cert-retry timer keeps trying.
      if [ -f "$FULLCHAIN" ] && [ -f "$PRIVKEY" ]; then
        TLS_CONFIG="tls-listening-port=5349
      cert=$COTURN_FULLCHAIN
      pkey=$COTURN_PRIVKEY"
      else
        echo "[$(date --iso-8601=seconds)] No certificate yet: starting coturn without TLS"
        TLS_CONFIG="no-tls
      no-dtls"
      fi

      cat > /etc/coturn/turnserver.conf <<EOF
      listening-port=3478
      $TLS_CONFIG
      $EXTERNAL_IP_LINE

      fingerprint
      realm=$TURN_REALM
      no-software-attribute

      use-auth-secret
      static-auth-secret=$TURN_SHARED_SECRET

      min-port=$RELAY_MIN_PORT
      max-port=$RELAY_MAX_PORT

      # No admin CLI: off by default since coturn 4.18 (the old no-cli flag is
      # deprecated). Nothing here may enable it (just check-privacy).

      # Randos only relays UDP audio between two browsers/clients.
      no-tcp-relay
      no-multicast-peers

      # Never relay to private, loopback, link-local (incl. the 169.254.169.254
      # metadata service, which holds this server's secret), CGNAT, benchmark,
      # or multicast/reserved addresses.
      denied-peer-ip=0.0.0.0-0.255.255.255
      denied-peer-ip=10.0.0.0-10.255.255.255
      denied-peer-ip=100.64.0.0-100.127.255.255
      denied-peer-ip=127.0.0.0-127.255.255.255
      denied-peer-ip=169.254.0.0-169.254.255.255
      denied-peer-ip=172.16.0.0-172.31.255.255
      denied-peer-ip=192.0.0.0-192.0.0.255
      denied-peer-ip=192.168.0.0-192.168.255.255
      denied-peer-ip=198.18.0.0-198.19.255.255
      denied-peer-ip=224.0.0.0-255.255.255.255
      denied-peer-ip=::1
      denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
      denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
      denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
      denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

      # Abuse limits sized for audio on a small droplet. No per-user quota:
      # every credential minted in the same second shares a username.
      total-quota=${total_quota}
      max-bps=${max_bps}

      # Anonymity: log errors only, no per-session lines (no caller IPs).
      log-min-level=error
      log-file=stdout
      EOF

      # The container runs coturn unprivileged; give its group read access only.
      chown root:65534 /etc/coturn/turnserver.conf
      chmod 640 /etc/coturn/turnserver.conf

      if [ -f "$FULLCHAIN" ] && [ -f "$PRIVKEY" ]; then
        install -m 0644 "$FULLCHAIN" "$COTURN_FULLCHAIN"
        install -m 0640 -g 65534 "$PRIVKEY" "$COTURN_PRIVKEY"
      fi

      mkdir -p /etc/letsencrypt/renewal-hooks/deploy
      cat > /etc/letsencrypt/renewal-hooks/deploy/restart-coturn <<'EOF'
      #!/usr/bin/env bash
      set -euo pipefail

      source /etc/randos-coturn.env

      RENEWED_CERT_DIR="$${RENEWED_LINEAGE:-/etc/letsencrypt/live/$${TURN_HOSTNAME}}"

      if [ -f "$${RENEWED_CERT_DIR}/fullchain.pem" ] && [ -f "$${RENEWED_CERT_DIR}/privkey.pem" ]; then
        install -m 0644 "$${RENEWED_CERT_DIR}/fullchain.pem" /etc/coturn/certs/fullchain.pem
        install -m 0640 -g 65534 "$${RENEWED_CERT_DIR}/privkey.pem" /etc/coturn/certs/privkey.pem
      fi

      if docker ps --format '{{.Names}}' | grep -qx coturn; then
        docker restart coturn
      fi
      EOF
      chmod 700 /etc/letsencrypt/renewal-hooks/deploy/restart-coturn

      systemctl enable --now certbot.timer || true

      if [ ! -f "$COTURN_FULLCHAIN" ] || [ ! -f "$COTURN_PRIVKEY" ]; then
        systemctl daemon-reload
        systemctl enable --now randos-coturn-cert-retry.timer
      fi

      # coturn's log goes to rsyslog, which zeroes every IP address before
      # writing /var/log/coturn.log (/etc/rsyslog.d/10-coturn.conf): its
      # error lines include callers' addresses ("Connection reset by peer
      # <ip>:<port>", denied peer IPs), found on the live relay 2026-10-21.
      # cache-disabled: no unscrubbed local copy for `docker logs` (Docker
      # keeps one for other drivers by default). Kept 7 days (logrotate).
      # rsyslog runs as syslog, which can't create files in /var/log here, so
      # the file is made for it (as Ubuntu does for its own logs).
      [ -f /var/log/coturn.log ] || install -o syslog -g adm -m 0640 /dev/null /var/log/coturn.log
      systemctl restart rsyslog

      docker rm -f coturn >/dev/null 2>&1 || true
      # Pinned image (var.coturn_image); upgrade deliberately by changing it.
      docker pull "$COTURN_IMAGE"
      docker run -d \
        --name coturn \
        --restart unless-stopped \
        --network host \
        --log-driver syslog \
        --log-opt syslog-address=udp://127.0.0.1:5514 \
        --log-opt tag=coturn \
        --log-opt cache-disabled=true \
        -v /etc/coturn:/etc/coturn:ro \
        "$COTURN_IMAGE" \
        -c /etc/coturn/turnserver.conf

      echo "[$(date --iso-8601=seconds)] coturn container started"
      docker ps --filter name=coturn

  # coturn's log, with every IP address zeroed before it's written. Docker
  # sends coturn's output here (UDP on localhost), not to the journal; this
  # ruleset handles it alone, so nothing reaches the general system log.
  - path: /etc/rsyslog.d/10-coturn.conf
    owner: root:root
    permissions: "0644"
    content: |
      module(load="imudp")
      module(load="mmanon")

      template(name="coturnLine" type="string" string="%timegenerated:::date-rfc3339% %msg%\n")

      ruleset(name="coturn") {
        action(type="mmanon"
               ipv4.enable="on" ipv4.mode="zero" ipv4.bits="32"
               ipv6.enable="on" ipv6.anonmode="zero" ipv6.bits="128"
               embeddedipv4.enable="on" embeddedipv4.anonmode="zero" embeddedipv4.bits="128")
        action(type="omfile" file="/var/log/coturn.log" template="coturnLine" fileCreateMode="0640")
        stop
      }

      input(type="imudp" address="127.0.0.1" port="5514" ruleset="coturn")

  # A week of (scrubbed) coturn log, then gone.
  - path: /etc/logrotate.d/coturn
    owner: root:root
    permissions: "0644"
    content: |
      /var/log/coturn.log {
        daily
        rotate 7
        create 0640 syslog adm
        missingok
        notifempty
        compress
        delaycompress
        postrotate
          /usr/lib/rsyslog/rsyslog-rotate
        endscript
      }

  # Reruns the bootstrap every 15 minutes until a certificate exists (the
  # rerun issues it and restarts coturn with TLS), then stops itself.
  - path: /etc/systemd/system/randos-coturn-cert-retry.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Retry Let's Encrypt issuance for coturn until it succeeds
      ConditionPathExists=!/etc/coturn/certs/fullchain.pem

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/randos-coturn-bootstrap

  - path: /etc/systemd/system/randos-coturn-cert-retry.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Retry coturn certificate issuance every 15 minutes

      [Timer]
      OnBootSec=10min
      OnUnitActiveSec=15min

      [Install]
      WantedBy=timers.target

runcmd:
  - /usr/local/sbin/randos-coturn-bootstrap

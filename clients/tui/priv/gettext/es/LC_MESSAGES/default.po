msgctxt "key"
msgid "join a link"
msgstr "Únete a un enlace"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "invitation link ready to share"
msgstr "Enlace de invitación listo para compartir"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Invitation"
msgstr "Invitación"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "couldn't copy the link: select it with the mouse"
msgstr "No pude copiar el enlace: selecciónelo con el ratón"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link copied"
msgstr "Enlace copiado"

#. The link went to the terminal's clipboard; some terminals ignore that, and no program can tell.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link sent to your terminal's clipboard (if it allows that)"
msgstr "Enlace enviado al portapapeles de su terminal (si su terminal lo permite)"

#. Key help, two or three characters: the 18+ box ("18+"), nothing more.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "18+"
msgstr "18+"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "copy the link"
msgstr "copiar el enlace"

#. %{key} is the name of a key (space), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "pick at least one language to hear (%{key} toggles one)"
msgstr "Seleccione al menos un idioma para escuchar (%{key} activa/desactiva una opción)"

#. The joiner hasn't ticked the 18+ box on the form yet. %{key} is the key's name (tab), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "tick the 18+ box first (%{key})"
msgstr "Primero, marque la casilla \"18+\" (%{key})"

#. %{yes} and %{no} are the keys to press (y, n), shown as they are.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "time is up: continue? (%{yes}/%{no})"
msgstr "El tiempo se ha acabado: ¿desea continuar? (%{yes}/%{no})"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "1  Off"
msgstr "1 Desactivado"

#. Voice timbre option: a brighter-sounding voice with higher resonances. Describes sound, not light or intelligence.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Brighter"
msgstr "Más brillante"

#. Voice timbre option: a fuller-sounding voice with lower resonances and more body. Not completeness or a person's name.

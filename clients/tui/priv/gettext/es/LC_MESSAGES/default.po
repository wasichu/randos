#, elixir-autogen, elixir-format
msgid "waiting for someone to open your link"
msgstr "esperando a que alguien abra tu enlace"

#. Key help: withdraw the invitation link, so it stops working.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "cancel the link"
msgstr "cancelar el enlace"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "invite"
msgstr "invitar"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join"
msgstr "unirse"

#: lib/tui/view.ex

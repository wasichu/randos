msgstr ""

#. How long the invitation link keeps working, as m:ss.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "%{time} left"
msgstr "剩余时间：%{time}"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Join through a link"
msgstr "通过链接加入"

#. The join prompt: put (paste, insert from the clipboard; the opposite of copy) the invitation link someone sent you.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Paste the link you were sent:"
msgstr "请粘贴您收到的链接："

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Send it to them however you like. It works once."
msgstr "您可以按照您喜欢的方式发送给他们。 只要发送一次即可。"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Waiting for your rando to open the link…"
msgstr "正在等待您的 rando 打开链接…"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "paste the whole link you were sent"
msgstr "粘贴您收到的整个链接"

#. The You panel's "Now:" row: your invitation link waits for someone.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "waiting for someone to open your link"
msgstr "等待有人打开你的链接"

#. Key help: withdraw the invitation link, so it stops working.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "cancel the link"
msgstr "取消链接"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "invite"
msgstr "邀请"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join"
msgstr "加入"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join a link"
msgstr "加入链接"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "invitation link ready to share"
msgstr "邀请链接已准备好分享"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Invitation"
msgstr "邀请"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "couldn't copy the link: select it with the mouse"
msgstr "无法复制链接:用鼠标选择"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link copied"
msgstr "链接已复制"

#. The link went to the terminal's clipboard; some terminals ignore that, and no program can tell.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link sent to your terminal's clipboard (if it allows that)"
msgstr "链接已发送至您的终端的剪贴板（如果您的终端支持此功能）。"

#. Key help, two or three characters: the 18+ box ("18+"), nothing more.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "18+"
msgstr "18岁以上"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "copy the link"
msgstr "复制链接"

#. %{key} is the name of a key (space), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "pick at least one language to hear (%{key} toggles one)"
msgstr "请选择至少一种语言来收听。（点击%{key}可以切换语言。）"

#. The joiner hasn't ticked the 18+ box on the form yet. %{key} is the key's name (tab), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "tick the 18+ box first (%{key})"
msgstr "请先勾选18+的选项框（ %{key}）。"

#. %{yes} and %{no} are the keys to press (y, n), shown as they are.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "time is up: continue? (%{yes}/%{no})"
msgstr "时间到：继续吗？（%{yes}/%{no}）"

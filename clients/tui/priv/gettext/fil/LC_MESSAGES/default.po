msgid "Matched"
msgstr "Nakatugma"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Time is up"
msgstr "Tapos na ang panahon"

#. The You panel's "Now:" row, before you press Enter to look for one.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "not looking for a rando"
msgstr "hindi naghahanap para sa isang rando"

#. How long the invitation link keeps working, as m:ss.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "%{time} left"
msgstr "%{time} na lang natitira"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Join through a link"
msgstr "Sumali sa pamamagitan ng link"

#. The join prompt: put (paste, insert from the clipboard; the opposite of copy) the invitation link someone sent you.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Paste the link you were sent:"
msgstr "I-paste ang link na iyong natanggap:"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Send it to them however you like. It works once."
msgstr "Ipadala niyo ito sa kanila sa paraang gusto ninyo. Gumagana ito nang isang beses."

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Waiting for your rando to open the link…"
msgstr "Hinihintay kong buksan ng iyong rando ang link…"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "paste the whole link you were sent"
msgstr ""

#. The joiner hasn't ticked the 18+ box on the form yet.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "tick the 18+ box on the form first"
msgstr "I-tick ang 18+ box sa form first"

#. The You panel's "Now:" row: your invitation link waits for someone.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "waiting for someone to open your link"
msgstr "naghihintay na may buksan ang iyong link"

#. Key help: withdraw the invitation link, so it stops working.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "cancel the link"
msgstr "kanselahin ang link"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "invite"
msgstr "imbitahan"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join"
msgstr "sumali"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join a link"
msgstr "sumali sa link"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "invitation link ready to share"
msgstr "Link para sa imbitasyon, handa nang ibahagi"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Invitation"
msgstr "Imbitasyon"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "couldn't copy the link: select it with the mouse"
msgstr "hindi maaaring kopyahin ang link: piliin ito gamit ang mouse"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link copied"
msgstr "Nakopya ang link"

#. The link went to the terminal's clipboard; some terminals ignore that, and no program can tell.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link sent to your terminal's clipboard (if it allows that)"
msgstr "Ang link ay ipinadala sa clipboard ng iyong terminal (kung pinapayagan ito)."

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "18+"
msgstr "18+"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "copy the link"
msgstr "kopya ang link"

msgid "Time is up"
msgstr "Waktu telah habis"

#. The You panel's "Now:" row, before you press Enter to look for one.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "not looking for a rando"
msgstr "tidak sedang mencari rando"

#. How long the invitation link keeps working, as m:ss.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "%{time} left"
msgstr "Sisa waktu %{time}"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Join through a link"
msgstr "Bergabunglah melalui tautan"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Paste the link you were sent:"
msgstr "Tempelkan tautan yang Anda terima:"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Send it to them however you like. It works once."
msgstr "Kirimkan saja ke mereka dengan cara yang kamu suka. Cara ini hanya berfungsi sekali."

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "Waiting for your rando to open the link…"
msgstr "Menunggu rando Anda membuka tautan tersebut…"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "paste the whole link you were sent"
msgstr "tempel seluruh tautan yang dikirimkan"

#. The joiner hasn't ticked the 18+ box on the form yet.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "tick the 18+ box on the form first"
msgstr "centang kotak 18+ pada formulir terlebih dahulu"

#. The You panel's "Now:" row: your invitation link waits for someone.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "waiting for someone to open your link"
msgstr "menunggu seseorang untuk membuka tautan Anda"

#. Key help: withdraw the invitation link, so it stops working.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "cancel the link"
msgstr "batalkan tautan"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "invite"
msgstr "mengundang"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join"
msgstr "bergabung"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join a link"
msgstr "ikuti tautan tersebut"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "invitation link ready to share"
msgstr "tautan undangan siap untuk dibagikan"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Invitation"
msgstr "Undangan"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "couldn't copy the link: select it with the mouse"
msgstr "tidak dapat menyalin tautan: pilih dengan tetikus"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link copied"
msgstr "tautan telah disalin"

#. The link went to the terminal's clipboard; some terminals ignore that, and no program can tell.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link sent to your terminal's clipboard (if it allows that)"
msgstr "tautan dikirim ke clipboard terminal Anda (jika terminal Anda mengizinkan fitur tersebut)"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "18+"
msgstr "18+ (Berlaku untuk usia 18 tahun ke atas)"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "copy the link"
msgstr "salin tautannya"

msgid "Waiting for your rando to open the link…"
msgstr "En attendant que votre rando ouvre le lien…"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "paste the whole link you were sent"
msgstr "collez tout le lien qui vous a été envoyé"

#. The You panel's "Now:" row: your invitation link waits for someone.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgid "waiting for someone to open your link"
msgstr "attendant que quelqu'un ouvre votre lien"

#. Key help: withdraw the invitation link, so it stops working.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "cancel the link"
msgstr "Annuler le lien"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "invite"
msgstr "inviter"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join"
msgstr "Rejoindre"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "join a link"
msgstr "joindre un lien"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "invitation link ready to share"
msgstr "lien d'invitation prêt à partager"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "panel title"
msgid "Invitation"
msgstr "Invitation"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "couldn't copy the link: select it with the mouse"
msgstr "Je n’ai pas pu copier le lien : sélectionnez-le avec la souris"

#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link copied"
msgstr "Lien copié"

#. The link went to the terminal's clipboard; some terminals ignore that, and no program can tell.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "link sent to your terminal's clipboard (if it allows that)"
msgstr "Lien envoyé dans le presse-papiers de votre terminal (si celui-ci le permet)."

#. Key help, two or three characters: the 18+ box ("18+"), nothing more.
#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "18+"
msgstr "18+"

#: lib/tui/view.ex
#, elixir-autogen, elixir-format
msgctxt "key"
msgid "copy the link"
msgstr "Copiez le lien"

#. %{key} is the name of a key (space), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "pick at least one language to hear (%{key} toggles one)"
msgstr "Sélectionnez au moins une langue pour l'écoute (%{key} active/désactive cette option)"

#. The joiner hasn't ticked the 18+ box on the form yet. %{key} is the key's name (tab), shown as it is.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgid "tick the 18+ box first (%{key})"
msgstr "Cochez d'abord la case indiquant que vous avez plus de 18 ans (%{key})."

#. %{yes} and %{no} are the keys to press (y, n), shown as they are.
#: lib/tui/model.ex
#, elixir-autogen, elixir-format
msgctxt "log"
msgid "time is up: continue? (%{yes}/%{no})"
msgstr "Le temps est écoulé: continuer? (%{yes}/%{no})"

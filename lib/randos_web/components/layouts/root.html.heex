<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} dir={RandosWeb.Locale.dir(assigns[:locale] || "en")}>
  <head>
    <meta charset="utf-8" />
    <meta name="randos-voice-worker" content={~p"/assets/js/randos/voice/masking_worker.js"} />
    <meta name="randos-voice-worklet" content={~p"/assets/js/randos/voice/masking_worklet.js"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="randos">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- The dev-only voice lab's script (RandosDev.VoiceLabLive sets voice_lab). --%>
    <script
      :if={assigns[:voice_lab]}
      type="module"
      src={~p"/assets/js/voice_lab.js"}
    >
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-stone-950">
    {@inner_content}
  </body>
</html>

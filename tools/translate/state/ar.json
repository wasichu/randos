  "The call ended because microphone access was blocked. Allow it, then look again.": {
    "model": "translategemma-4b",
    "msgstr": "انتهت المكالمة بسبب حظر الوصول إلى الميكروفون. يرجى السماح بذلك، ثم حاول مرة أخرى."
  },
  "The call ended because no microphone was found.": {
    "model": "translategemma-12b",
    "msgstr": "انتهت المكالمة لعدم وجود ميكروفون."
  },
  "The commit this server runs": {
    "model": "hy-mt2",
    "msgstr": "عملية الالتزام التي يقوم بها هذا الخادم"
  },
  "The interface is quiet on purpose. The goal is low-pressure human presence, not performance or engagement loops.": {
    "model": "translategemma-27b",
    "msgstr": "الواجهة مُصمَّمة لتكون هادئة عن قصد. والهدف هو تحقيق تواصل إنساني مريح وغير مُرهِق، وليس التركيز على الأداء أو خلق حلقات تفاعلية مستمرة."
  },
  "The relay is partly working": {
    "model": "madlad-400",
    "msgstr": "المرحّل يعمل جزئيا"

  },
  "Pick at least one language to hear": {
    "model": "hy-mt2",
    "msgstr": "들을 언어를 하나 이상 선택하세요."
  },
  "Pick every language you're comfortable listening to.": {
    "model": "hy-mt2",
    "msgstr": "듣기에 편안한 모든 언어를 골라주세요."
  },
  "Pick the language you'd like to check.": {
    "model": "hy-mt2",
    "msgstr": "검사하고 싶은 언어를 선택하세요."
  },
  "Preparing the call": {
    "model": "hy-mt2",
    "msgstr": "전화를 준비하고 있습니다."
  },

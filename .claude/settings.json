{
  "permissions": {
    "allow": [
      "Bash(just serve)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mkdir -p tmp && (nohup just serve > tmp/serve.log 2>&1 &)",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mkdir -p tmp && (nohup just serve > tmp/serve.log 2>&1 &)",
            "async": true
          }
        ]
      }
    ]
  }
}
